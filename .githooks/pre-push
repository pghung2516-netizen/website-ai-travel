#!/bin/sh
# Pre-push hook: Chặn tuyệt đối việc push bất kỳ commit nào chứa file .codegraph

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Branch deletion
        continue
    fi

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch: kiểm tra tất cả các file trong commit
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    # Kiểm tra danh sách file bị thay đổi
    codegraph_files=$(git diff --name-only "$range" | grep -E "(^|/)\.codegraph(/|$)")
    if [ -n "$codegraph_files" ]; then
        echo "=================================================================="
        echo "❌ LỖI BẢO VỆ: Phát hiện file thuộc .codegraph chuẩn bị được push!"
        echo "   Push đã bị huỷ tự động để ngăn chặn rò rỉ .codegraph lên GitHub."
        echo "   Các file vi phạm:"
        echo "$codegraph_files"
        echo "=================================================================="
        exit 1
    fi
done

exit 0
